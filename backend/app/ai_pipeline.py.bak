import httpx

from app.config import settings


def call_qwen(prompt: str) -> str:
    response = httpx.post(
        f"{settings.ollama_url}/api/generate",
        json={
            "model": settings.ollama_model,
            "prompt": prompt,
            "stream": False,
            "think": False,
            "options": {
                "temperature": 0.45,
                "num_predict": 8192,
                "num_ctx": 32768,
            },
        },
        timeout=1800,
    )
    response.raise_for_status()
    return response.json()["response"].strip()


def count_words(text: str) -> int:
    return len(text.split())


def generate_script(title: str, duration_minutes: int, video_style: str) -> dict:
    target = duration_minutes * 145
    minimum = target - 20
    maximum = target + 20

    prompt = (
        f"Write an original YouTube narration about: {title}\n"
        f"Style: {video_style}. Auto-detect when style is auto.\n"
        f"Write between {minimum} and {maximum} words.\n"
        "Return only the narration. No headings or notes."
    )

    script = call_qwen(prompt)

    for attempt in range(1, 5):
        words = count_words(script)

        if minimum <= words <= maximum:
            return {
                "script": script,
                "word_count": words,
                "attempt": attempt,
            }

        if words < minimum:
            difference = target - words
            action = f"Expand it by approximately {difference} words."
        else:
            difference = words - target
            action = f"Shorten it by approximately {difference} words."

        script = call_qwen(
            f"{action}\n"
            f"Final length must be between {minimum} and {maximum} words.\n"
            "Return only the complete revised narration.\n\n"
            f"{script}"
        )

    raise ValueError("Script could not reach the required word length.")
